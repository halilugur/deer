{
  "title": "Trigonometric Calculation Example (cos(x) & sin(y))",
  "nodes": [
    {
      "id": "node_start",
      "node_type": "Start",
      "x": 300.0,
      "y": 60.0,
      "width": 100.0,
      "height": 40.0,
      "title": "Başla",
      "expr1": "",
      "expr2": "",
      "target_var": ""
    },
    {
      "id": "node_init",
      "node_type": "Definition",
      "x": 250.0,
      "y": 140.0,
      "width": 200.0,
      "height": 40.0,
      "title": "Açı ve Değişken Tanımları",
      "expr1": "t = 0, step_val = 0.2, max_t = 40, x = 0, y = 0, cosx = 0, siny = 0",
      "expr2": "",
      "target_var": ""
    },
    {
      "id": "node_cond",
      "node_type": "IfLess",
      "x": 270.0,
      "y": 220.0,
      "width": 160.0,
      "height": 60.0,
      "title": "t < max_t",
      "expr1": "t",
      "expr2": "max_t",
      "target_var": ""
    },
    {
      "id": "node_calc",
      "node_type": "Definition",
      "x": 220.0,
      "y": 320.0,
      "width": 260.0,
      "height": 40.0,
      "title": "cos(x) ve sin(y) Hesapla",
      "expr1": "x = t * step_val, y = t * step_val * 1.5, cosx = cos(x), siny = sin(y)",
      "expr2": "",
      "target_var": ""
    },
    {
      "id": "node_out",
      "node_type": "Output",
      "x": 250.0,
      "y": 400.0,
      "width": 200.0,
      "height": 40.0,
      "title": "Sonuçları Göster",
      "expr1": "cosx",
      "expr2": "siny",
      "target_var": ""
    },
    {
      "id": "node_step",
      "node_type": "Definition",
      "x": 270.0,
      "y": 480.0,
      "width": 160.0,
      "height": 40.0,
      "title": "Sayaç Artır",
      "expr1": "t = t + 1",
      "expr2": "",
      "target_var": ""
    },
    {
      "id": "node_stop",
      "node_type": "Stop",
      "x": 520.0,
      "y": 230.0,
      "width": 100.0,
      "height": 40.0,
      "title": "Dur",
      "expr1": "",
      "expr2": "",
      "target_var": ""
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_id": "node_start",
      "to_id": "node_init",
      "condition": "Default"
    },
    {
      "id": "c2",
      "from_id": "node_init",
